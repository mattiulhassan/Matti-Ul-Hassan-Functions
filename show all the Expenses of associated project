Finish = 0;
Misc = 0;
Permit = 0;
Plumbing = 0;
Rebar = 0;
Shotcrete = 0;
Tile = 0;
Walls = 0;
for each  rec in expense
{
	record = zoho.books.getRecordsByID("expenses",organizationID,rec.get("expense_id"),"books");
	exp = record.get("expense");
	tags = ifnull(exp.get("tags"),List());
	total = exp.get("total");
	for each  tag in tags
	{
		if(tag.get("tag_name") == "Pool Category")
		{
			option = tag.get("tag_option_name");
			if(option == "Clean Up")
			{
				CleanUp = CleanUp + total;
			}
			if(option == "Demolition")
			{
				Demolition = Demolition + total;
			}
